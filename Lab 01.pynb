down","source":["#User Input"],"metadata":{"id":"XDqFeCej15Lh"}},{"cell_type":"code","source":["n = int (input ( 'Enter a Number '))\n","print (n)\n","\n","x = n + 10\n","print (x)"],"metadata":{"id":"zmMU_ML_1823"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## Loops"],"metadata":{"id":"hP4wgCwF18Yu"}},{"cell_type":"code","source":["for i in range (1, 10, 2):\n","  print(i)"],"metadata":{"id":"2KbpaDF-235D"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["for i in range (10, 1, -1):\n","  print(i, end = \" \")"],"metadata":{"id":"sd080wAH4Akn"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["#List"],"metadata":{"id":"cOglbzGI6TKJ"}},{"cell_type":"code","source":["list = list ()\n","print (type())\n","list = [10 , 20, 30, 40, 50, 60]\n","print (list[0])"],"metadata":{"id":"vRz2UzNF6UjL"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["marks = []\n","marks.append (78)\n","print ( marks )"],"metadata":{"id":"KrElJsC67Zir"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","marks.append (80)\n","marks.insert( 1, 'AI')\n","print(marks)\n","\n","marks.pop(1)\n","print(marks)\n","\n","#marks.remove(80)\n","print (marks.index (80))"],"metadata":{"id":"Eu4IP7L5773a"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# Searching\n","\n","target = 80\n","if target in marks :\n","  marks.remove(target)\n","print (marks)\n"],"metadata":{"id":"QTdOIeMF9iZ_"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["list = [10, 20, 30, 40, 50, 60, 70]\n","# Iteration: index based\n","for i in range (len(list)) :\n","  print(list[i])\n","\n","# Iteration: index based\n","for i in list:\n","  print(i)\n"],"metadata":{"id":"5jWP0lge-RX8"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["#List Slicing"],"metadata":{"id":"_6u5q24E_Urf"}},{"cell_type":"code","source":["nl1 = list[1:5:2]\n","print(nl1)"],"metadata":{"id":"-w